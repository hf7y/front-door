#!/usr/bin/env bash
# Ping Zach off-repo. The channel the front door cannot reach itself.
#
#   bin/ping "milestone 001 due tomorrow"
#   bin/ping -s "front-door" -f body.md
#   echo "..." | bin/ping
#   bin/ping --all "..."        try every transport, not just the first that works
#
# Transport order, best reach first:
#   1. hermes send   — WhatsApp/Signal/etc. Reaches the phone anywhere.
#   2. KDE Connect   — paired phone, same LAN only. Free, no cloud.
#   3. notify-send   — this desktop only.
#   4. stderr        — loud, so an undelivered ping is never silent.
# Exit 0 if any transport delivered, 1 if none did.
set -uo pipefail

SUBJECT="front-door"
BODY=""
TARGET="${FRONT_DOOR_PING_TARGET:-}"
ALL=0
FORCE=0

while [ $# -gt 0 ]; do
  case "$1" in
    -s|--subject) SUBJECT="$2"; shift 2 ;;
    -f|--file)    BODY="$(cat -- "$2")"; shift 2 ;;
    -t|--to)      TARGET="$2"; shift 2 ;;
    --all)        ALL=1; shift ;;
    --force)      FORCE=1; shift ;;
    -h|--help)    sed -n '2,16p' "$0"; exit 0 ;;
    *)            BODY="${BODY:+$BODY }$1"; shift ;;
  esac
done
[ -n "$BODY" ] || BODY="$(cat)"
[ -n "${BODY//[[:space:]]/}" ] || { echo "ping: empty message" >&2; exit 2; }

# Don't buzz the same phone twice for the same news. A repeated identical
# message inside the dedupe window is dropped. FRONT_DOOR_PING_DEDUPE_SECS=0
# or --force disables. State: .ping-log (gitignored).
DEDUPE="${FRONT_DOOR_PING_DEDUPE_SECS:-3600}"
LOG="$(cd "$(dirname "$0")/.." && pwd)/.ping-log"
if [ "$FORCE" -eq 0 ] && [ "$DEDUPE" -gt 0 ] 2>/dev/null; then
  SIG="$(printf '%s\n%s' "$SUBJECT" "$BODY" | cksum | tr -d ' ')"
  NOW="$(date +%s)"
  if [ -r "$LOG" ]; then
    LAST="$(awk -v s="$SIG" '$1==s {print $2}' "$LOG" | tail -1)"
    if [ -n "$LAST" ] && [ $((NOW - LAST)) -lt "$DEDUPE" ]; then
      echo "ping: suppressed duplicate (sent $((NOW - LAST))s ago; --force to override)" >&2
      exit 0
    fi
  fi
  printf '%s %s\n' "$SIG" "$NOW" >> "$LOG" 2>/dev/null || true
  # Keep the log small.
  if [ "$(wc -l < "$LOG" 2>/dev/null || echo 0)" -gt 200 ]; then
    tail -100 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null || true
  fi
fi

delivered=0
skip() { [ "$ALL" -eq 0 ] && [ "$delivered" -eq 1 ]; }

# 1. hermes — configured messaging platform (WhatsApp, Signal, ...). Best reach:
#    works wherever the phone has data, not just on the home network.
if ! skip && command -v hermes >/dev/null 2>&1; then
  if [ -z "$TARGET" ]; then
    listing="$(hermes send --list 2>/dev/null)"
    case "$listing" in
      *"No messaging platforms"*|*"no channels discovered"*|'') TARGET="" ;;
      *) TARGET="$(printf '%s\n' "$listing" \
           | grep -oE '\b(whatsapp|signal|telegram|discord|slack)(:[^[:space:]]+)?' \
           | head -1)" ;;
    esac
  fi
  # --list only reports channels the gateway has *discovered*. A freshly paired
  # platform is configured and sendable but not yet listed, so fall back to the
  # platform's home channel for anything marked enabled in hermes' env.
  if [ -z "$TARGET" ] && [ -r "$HOME/.hermes/.env" ]; then
    for plat in whatsapp signal telegram discord slack; do
      up="$(printf '%s' "$plat" | tr '[:lower:]' '[:upper:]')"
      if grep -qE "^${up}_ENABLED=(true|1|yes)$" "$HOME/.hermes/.env" 2>/dev/null; then
        TARGET="$plat"; break
      fi
    done
  fi
  if [ -n "$TARGET" ]; then
    if printf '%s' "$BODY" | hermes send --to "$TARGET" --subject "$SUBJECT" --quiet 2>/dev/null; then
      echo "ping: delivered via hermes ($TARGET)" >&2
      delivered=1
    else
      echo "ping: hermes send failed for target '$TARGET'" >&2
    fi
  else
    echo "ping: hermes has no configured platform — run 'hermes whatsapp'" >&2
  fi
fi

# 2. KDE Connect — straight to the paired phone. Same LAN only.
#    Set FRONT_DOOR_SMS_TO=+15551234567 to send a real SMS through the phone.
if ! skip && command -v kdeconnect-cli >/dev/null 2>&1; then
  DEV="${FRONT_DOOR_KDE_DEVICE:-}"
  if [ -z "$DEV" ]; then
    DEV="$(kdeconnect-cli --list-devices 2>/dev/null \
      | grep 'paired and reachable' \
      | sed -n 's/.*: \([0-9a-f]\{8,\}\).*/\1/p' | head -1)"
  fi
  if [ -n "$DEV" ]; then
    sent=0
    if [ -n "${FRONT_DOOR_SMS_TO:-}" ]; then
      if kdeconnect-cli -d "$DEV" --send-sms "$SUBJECT: $BODY" \
           --destination "$FRONT_DOOR_SMS_TO" 2>/dev/null; then
        echo "ping: delivered as SMS to $FRONT_DOOR_SMS_TO via $DEV" >&2
        sent=1; delivered=1
      else
        echo "ping: kdeconnect SMS failed (phone reachable?)" >&2
      fi
    fi
    if [ "$sent" -eq 0 ]; then
      if kdeconnect-cli -d "$DEV" --ping-msg "$SUBJECT: $BODY" 2>/dev/null; then
        echo "ping: delivered as phone notification via $DEV" >&2
        delivered=1
      fi
    fi
  else
    echo "ping: no paired-and-reachable kdeconnect device" >&2
  fi
fi

# 3. This desktop.
if ! skip && command -v notify-send >/dev/null 2>&1; then
  if notify-send -u normal -- "$SUBJECT" "$BODY" 2>/dev/null; then
    echo "ping: delivered via notify-send (desktop only)" >&2
    delivered=1
  fi
fi

# 4. Never fail silently.
if [ "$delivered" -eq 0 ]; then
  printf '\n=== PING UNDELIVERED: %s ===\n%s\n===\n' "$SUBJECT" "$BODY" >&2
  exit 1
fi
