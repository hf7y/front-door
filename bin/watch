#!/usr/bin/env bash
# Watch the front door. One stdout line per event; nothing when quiet.
#
#   bin/watch            poll forever (default 60s)
#   bin/watch --once     single sweep, then exit
#   bin/watch -i 30      set interval
#
# Watches for: knocks and comments from anyone other than the repo owner,
# failed workflow runs, and milestone deadlines coming due.
# State lives in .watch-state (gitignored) so restarts don't replay history.
set -uo pipefail

REPO="${FRONT_DOOR_REPO:-hf7y/front-door}"
OWNER="${REPO%%/*}"
INTERVAL=60
ONCE=0
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$ROOT/.watch-state"

NOTIFY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --once)        ONCE=1; shift ;;
    --notify)      NOTIFY=1; shift ;;
    -i|--interval) INTERVAL="$2"; shift 2 ;;
    -h|--help)     sed -n '2,12p' "$0"; exit 0 ;;
    *)             echo "watch: unknown arg $1" >&2; exit 2 ;;
  esac
done

# PREFLIGHT — fail loud, never quiet. Every probe below is `|| true`-guarded so a
# transient API blip cannot kill a long-running watch; that same guard means a
# MISSING or UNAUTHENTICATED gh would produce an empty sweep, which reads exactly
# like "nothing is happening at the door". The cloud doorkeeper hit precisely this
# on 2026-07-30 (spawnSync gh ENOENT). So check up front and refuse to run.
if ! command -v gh >/dev/null 2>&1; then
  echo "watch: FAIL: gh CLI not found — cannot see the door. Refusing to report silence as calm." >&2
  exit 2
fi
if ! gh auth status >/dev/null 2>&1; then
  echo "watch: FAIL: gh is present but not authenticated — cannot see the door. Refusing to report silence as calm." >&2
  exit 2
fi

SINCE="$(cat "$STATE" 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
SEEN_RUNS="$ROOT/.watch-runs"; touch "$SEEN_RUNS" 2>/dev/null || true

sweep() {
  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # Comments from the collaborator (a knock), PLUS reports written by an agent
  # acting as the owner. The cloud doorkeeper posts as the owner, so a plain
  # "not the owner" filter hid its sweeps entirely — found 2026-07-30, when its
  # first real report never reached the phone. Owner comments still do not relay
  # in general; only ones carrying an agent marker, so Zach's own typing stays quiet.
  # NB: `gh api` has no --arg, so $OWNER is interpolated by the shell. Passing
  # --arg made jq fail with an undefined variable, and the 2>/dev/null below ate
  # the error — the sweep looked merely quiet. Errors are surfaced now.
  local jq_comments errf
  jq_comments='.[]
    | select((.user.login != "'"$OWNER"'") or (.body // "" | test("Generated by \\[Claude Code\\]|Doorkeeper sweep")))
    | if .user.login == "'"$OWNER"'"
      then "doorkeeper: report on #\(.issue_url | split("/") | last) — \(.html_url)"
      else "knock: comment by \(.user.login) on issue \(.issue_url | split("/") | last) — \(.html_url)"
      end'
  errf="$(mktemp)"
  gh api "repos/$REPO/issues/comments?since=$SINCE&per_page=100" --jq "$jq_comments" 2>"$errf" || true
  if [ -s "$errf" ]; then
    echo "watch: PROBE ERROR reading comments — this is not silence: $(tr '\n' ' ' < "$errf" | cut -c1-160)"
  fi
  rm -f "$errf"

  # New or reopened issues not opened by the owner.
  gh api "repos/$REPO/issues?state=all&since=$SINCE&per_page=100" \
    --jq ".[] | select(.user.login != \"$OWNER\") | select(.pull_request == null) | \"knock: issue #\(.number) \(.state) by \(.user.login) — \(.title)\"" \
    2>/dev/null || true

  # Pull requests from anyone — an amendment PR is how the contract changes.
  gh api "repos/$REPO/pulls?state=open&per_page=50" \
    --jq '.[] | "amendment: PR #\(.number) by \(.user.login) — \(.title)"' \
    2>/dev/null | while read -r line; do
      grep -qxF "$line" "$SEEN_RUNS" 2>/dev/null || { echo "$line"; echo "$line" >> "$SEEN_RUNS"; }
    done

  # Failed workflow runs, each reported once.
  gh run list --repo "$REPO" --limit 15 \
    --json databaseId,conclusion,event,url \
    --jq '.[] | select(.conclusion=="failure") | "\(.databaseId)|ritual FAILED (\(.event)) — \(.url)"' \
    2>/dev/null | while IFS='|' read -r id msg; do
      grep -qxF "run:$id" "$SEEN_RUNS" 2>/dev/null || { echo "$msg"; echo "run:$id" >> "$SEEN_RUNS"; }
    done

  # Milestone clock — only speaks when due within a day or overdue.
  if command -v node >/dev/null 2>&1; then
    local clk; clk="$(node "$ROOT/protocol/clock.mjs" 2>/dev/null)" || true
    case "$clk" in
      *OVERDUE*)    echo "clock: $(printf '%s' "$clk" | grep -m1 OVERDUE | sed 's/^ *//')" ;;
      *"DUE TODAY"*) echo "clock: $(printf '%s' "$clk" | grep -m1 'DUE TODAY' | sed 's/^ *//')" ;;
    esac
  fi

  SINCE="$now"
  printf '%s' "$now" > "$STATE" 2>/dev/null || true
}

# Relay each event to the phone. GitHub Actions cannot reach the local WhatsApp
# bridge (127.0.0.1 only), so this machine is the bridge: watch sees the GitHub
# event, bin/ping carries it to WhatsApp. bin/ping dedupes, so a condition that
# stays true does not buzz repeatedly.
run_sweep() {
  if [ "$NOTIFY" -eq 0 ]; then sweep; return; fi
  local out; out="$(sweep)"
  [ -n "$out" ] || return 0
  printf '%s\n' "$out"
  printf '%s\n' "$out" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    "$ROOT/bin/ping" -s "front-door" "$line" >/dev/null 2>&1 || true
  done
}

if [ "$ONCE" -eq 1 ]; then run_sweep; exit 0; fi
while true; do run_sweep; sleep "$INTERVAL"; done
